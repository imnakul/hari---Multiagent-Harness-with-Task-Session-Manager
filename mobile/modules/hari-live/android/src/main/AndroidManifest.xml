<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <!-- Fork (Hari, L-239): running sessions as an Android 16 Live Update. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Fork (Hari, L-280): the phone's network type for the computer's Share popover. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- Fork (Hari, L-297): the computer's "Phone files" browser (sideloaded APK; the user turns on All files access). -->
  <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
  <!-- Fork (Hari, L-321): the Share bubble over other apps (the user turns on Display over other apps). -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Fork (Hari, L-398, L-405): screen time for the computer's Activity. Android lists an
       app under Usage access only when it declares this (the user turns it on there). -->
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
  <!-- Fork (Hari, L-325): names and icons of the apps whose notifications go to the computer. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application>
    <service
      android:name="expo.modules.harilive.HariLiveService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Shows the coding sessions running on the user's paired computer as a Live Update, and keeps their status current while the phone is locked. If the user turns on background watching, also checks the paired computer for new notifications (agent finished, needs approval) and posts them." />
    </service>
    <receiver
      android:name="expo.modules.harilive.HariLiveReceiver"
      android:exported="false" />
    <!-- Fork (Hari, L-280): Find my phone's Stop. -->
    <receiver
      android:name="expo.modules.harilive.HariRingReceiver"
      android:exported="false" />
    <!-- Fork (Hari, L-279): Share. The share sheet's Hari target (also opened
         by the tile to read the clipboard), and the Send clipboard tile. -->
    <activity
      android:name="expo.modules.harilive.HariShareActivity"
      android:exported="true"
      android:label="Hari: send to computer"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>
    <!-- Fork (Hari, L-303): sends what was shared with no window (Headless JS). -->
    <service
      android:name="expo.modules.harilive.HariShareTask"
      android:exported="false" />
    <service
      android:name="expo.modules.harilive.HariClipboardTile"
      android:exported="true"
      android:icon="@drawable/hari_live_icon"
      android:label="Send clipboard"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
    <!-- Fork (Hari, L-325): reads the phone's notifications for the computer
         (the user turns on Notification access for Hari). -->
    <service
      android:name="expo.modules.harilive.HariNotificationListener"
      android:exported="true"
      android:label="Hari: notifications on computer"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>
    <!-- Fork (Hari, L-321): draws the Share bubble. -->
    <service
      android:name="expo.modules.harilive.HariBubbleService"
      android:exported="false" />
  </application>
</manifest>
