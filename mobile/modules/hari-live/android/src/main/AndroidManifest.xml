<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Fork (Hari, L-239): running sessions as an Android 16 Live Update. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <!-- Fork (Hari, L-280): the phone's network type for the computer's Share popover. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <application>
    <service
      android:name="expo.modules.harilive.HariLiveService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Shows the coding sessions running on the user's paired computer as a Live Update, and keeps their status current while the phone is locked. If the user turns on background watching, also checks the paired computer for new notifications (agent finished, needs approval) and posts them." />
    </service>
    <receiver
      android:name="expo.modules.harilive.HariLiveReceiver"
      android:exported="false" />
    <!-- Fork (Hari, L-280): Find my phone's Stop. -->
    <receiver
      android:name="expo.modules.harilive.HariRingReceiver"
      android:exported="false" />
    <!-- Fork (Hari, L-279): Share. The share sheet's Hari target (also opened
         by the tile to read the clipboard), and the Send clipboard tile. -->
    <activity
      android:name="expo.modules.harilive.HariShareActivity"
      android:exported="true"
      android:label="Hari: send to computer"
      android:excludeFromRecents="true"
      android:noHistory="true"
      android:taskAffinity=""
      android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="android.intent.action.SEND" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.SEND_MULTIPLE" />
        <category android:name="android.intent.category.DEFAULT" />
        <data android:mimeType="*/*" />
      </intent-filter>
    </activity>
    <service
      android:name="expo.modules.harilive.HariClipboardTile"
      android:exported="true"
      android:icon="@drawable/hari_live_icon"
      android:label="Send clipboard"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
  </application>
</manifest>
